# =============================================================
# MJ AI Assistant — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# ── App ───────────────────────────────────────────────────────
APP_NAME="MJ AI Assistant"
APP_ENV=development          # development | staging | production
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
API_V1_PREFIX=/api/v1

# ── Backend ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── PostgreSQL + pgvector ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mj_ai_assistant
POSTGRES_USER=mj_user
POSTGRES_PASSWORD=mj_secure_password
DATABASE_URL=postgresql+asyncpg://mj_user:mj_secure_password@localhost:5432/mj_ai_assistant

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ── LLM Providers ─────────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=
OPENAI_DEFAULT_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=AIza...
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Active Provider
DEFAULT_LLM_PROVIDER=openai    # openai | gemini | claude | ollama

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── MCP (Model Context Protocol) ──────────────────────────────
MCP_GATEWAY_PORT=9000
MCP_GITHUB_TOKEN=ghp_...
MCP_FILESYSTEM_ROOT=/workspace

# ── Tool APIs ─────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...        # Web search
SERPER_API_KEY=...             # Alternative search
BRAVE_SEARCH_API_KEY=BSA...    # Brave search

# ── Voice ─────────────────────────────────────────────────────
WHISPER_MODEL=whisper-1        # STT model
TTS_VOICE=alloy                # TTS voice (alloy|echo|fable|onyx|nova|shimmer)

# ── Email ─────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ── GitHub ────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=

# ── Observability ─────────────────────────────────────────────
# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=mj-ai-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mj-ai-assistant
OTEL_TRACES_EXPORTER=otlp

# Prometheus / Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ── Security ──────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# ── Autonomy ──────────────────────────────────────────────────
DEFAULT_AUTONOMY_LEVEL=1       # 0=chat | 1=ask | 2=auto_safe | 3=full_auto
MAX_AGENT_RETRIES=3
AGENT_TIMEOUT_SECONDS=120

# ── Background Workers ────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
WORKER_CONCURRENCY=4

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,csv,png,jpg,jpeg,mp3,wav
